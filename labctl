#!/usr/bin/env bash
# labctl — manager untuk CTF Lab.
#
# Dua mode:
#   docker  : build & jalankan mesin pakai Docker (untuk PC/VPS yang punya Docker).
#   lite    : jalankan mesin ringan langsung sebagai proses di NetHunter (tanpa Docker).
#
# Pemakaian:
#   ./labctl list
#   ./labctl docker up 01-pingboard | down | build | status
#   ./labctl lite  up 01-pingboard | down | status
#   ./labctl check 01-pingboard 'FLAG{...}'   # cek jawaban flag Anda
#   ./labctl selftest lite|docker [id|all]    # uji otomatis: jalan+serang+verifikasi
#   ./labctl flags                 # tampilkan flag mana yang terpasang
#
# Flag dibaca dari ./flags.env (lihat flags.env.example). Kalau tidak ada,
# dipakai nilai placeholder. Butuh python3 (tanpa jq). Set LAB_BIND=0.0.0.0
# untuk akses dari perangkat lain di jaringan.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MACHINES="$ROOT/machines"
RUNDIR="$ROOT/.run"
BIND="${LAB_BIND:-127.0.0.1}"
PJ="python3 $ROOT/.pj.py"

c_red=$'\e[31m'; c_grn=$'\e[32m'; c_ylw=$'\e[33m'; c_cyn=$'\e[36m'; c_rst=$'\e[0m'
info(){ printf '%s[*]%s %s\n' "$c_cyn" "$c_rst" "$*"; }
ok(){   printf '%s[+]%s %s\n' "$c_grn" "$c_rst" "$*"; }
warn(){ printf '%s[!]%s %s\n' "$c_ylw" "$c_rst" "$*"; }
err(){  printf '%s[x]%s %s\n' "$c_red" "$c_rst" "$*" >&2; }

pj_get(){  $PJ "$1" get  "$2" "${3:-}"; }
pj_arr(){  $PJ "$1" arr  "$2"; }
pj_keys(){ $PJ "$1" keys "$2"; }
pj_has(){  $PJ "$1" has  "$2"; }

# ---- helpers ---------------------------------------------------------------

load_flags(){
  [ -f "$ROOT/flags.env" ] && set -a && . "$ROOT/flags.env" && set +a || true
}

# flag_value <MACHINEID> <SLOT>  -> echo nilai flag (atau placeholder)
flag_value(){
  local mid slot var
  mid="$(echo "$1" | sed 's/[^A-Za-z0-9]/_/g' | tr '[:lower:]' '[:upper:]')"
  slot="$(echo "$2" | tr '[:lower:]' '[:upper:]')"
  var="FLAG_${mid}_${slot}"
  local def="FLAG{placeholder_${1}_${2}}"
  echo "${!var:-$def}"
}

machine_dir(){ echo "$MACHINES/$1"; }

require_machine(){
  [ -d "$(machine_dir "$1")" ] && return 0
  err "mesin '$1' tidak ada. Lihat: ./labctl list"; exit 1
}

# ---- list ------------------------------------------------------------------

cmd_list(){
  printf '%-16s %-8s %-10s %-6s %-6s %s\n' ID DIFF KATEGORI DOCKER LITE NAMA
  printf '%-16s %-8s %-10s %-6s %-6s %s\n' "----------------" "--------" "----------" "------" "------" "----"
  for d in "$MACHINES"/*/; do
    [ -f "$d/machine.json" ] || continue
    local j; j="$d/machine.json"
    printf '%-16s %-8s %-10s %-6s %-6s %s\n' \
      "$(pj_get "$j" id)" "$(pj_get "$j" difficulty)" "$(pj_get "$j" category)" \
      "$(pj_get "$j" ports.0.host -)" "$(pj_get "$j" lite.port -)" "$(pj_get "$j" name)"
  done
}

cmd_flags(){
  load_flags
  for d in "$MACHINES"/*/; do
    [ -f "$d/machine.json" ] || continue
    local j id; j="$d/machine.json"; id=$(pj_get "$j" id)
    for slot in $(pj_arr "$j" flags); do
      local v; v="$(flag_value "$id" "$slot")"
      case "$v" in
        FLAG\{placeholder_*) warn "$id/$slot : placeholder (set di flags.env)";;
        *) ok "$id/$slot : terpasang";;
      esac
    done
  done
}

# ---- check (penilaian flag) ------------------------------------------------

cmd_check(){
  load_flags
  local id="${1:-}"; local guess="${2:-}"
  [ -n "$id" ] && [ -n "$guess" ] || {
    err "pemakaian: ./labctl check <id-mesin> '<FLAG{...}>'"; exit 1; }
  require_machine "$id"
  local j; j="$(machine_dir "$id")/machine.json"
  # Normalisasi: buang spasi di tepi.
  guess="$(printf '%s' "$guess" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  local matched=""
  for slot in $(pj_arr "$j" flags); do
    local v; v="$(flag_value "$id" "$slot")"
    case "$v" in FLAG\{placeholder_*) continue;; esac
    if [ "$guess" = "$v" ]; then matched="$slot"; break; fi
  done
  if [ -n "$matched" ]; then
    ok "BENAR! $id/$matched terpecahkan."
    # Sarankan lab berikutnya (urutan folder).
    local nxt=""; local prev=""
    for d in "$MACHINES"/*/; do
      [ -f "$d/machine.json" ] || continue
      local mid; mid="$(basename "$d")"
      if [ -n "$prev" ] && [ "$prev" = "$id" ]; then nxt="$mid"; break; fi
      prev="$mid"
    done
    if [ -n "$nxt" ]; then
      printf '    Lanjut ke lab berikutnya: %s\n' "$nxt"
      printf '    Materi : machines/%s/MATERI.md\n' "$nxt"
      printf '    Jalan  : ./ctf-tmux %s\n' "$nxt"
    else
      printf '    Itu lab terakhir. Semua modul selesai, mantap!\n'
    fi
  else
    err "Salah. Flag itu tidak cocok untuk mesin '$id'. Coba lagi."
    exit 2
  fi
}

# ---- selftest (otomatis: jalankan + serang + verifikasi tiap mesin) --------

# Tunggu server siap. args: kategori port tries
_sel_ready(){
  local c="$1" p="$2" n="$3" i=0
  while [ "$i" -lt "$n" ]; do
    if [ "$c" = "pwn" ]; then
      if (exec 3<>"/dev/tcp/$BIND/$p") 2>/dev/null; then exec 3>&- 3<&-; return 0; fi
    else
      curl -s -o /dev/null --max-time 2 "http://$BIND:$p/" 2>/dev/null && return 0
    fi
    i=$((i + 1)); sleep 0.5
  done
  return 1
}

cmd_selftest(){
  load_flags
  local mode="${1:-}" which="${2:-all}"
  case "$mode" in
    lite) ;;
    docker) docker_ok ;;
    *) err "pemakaian: ./labctl selftest <lite|docker> [id|all]"; exit 1 ;;
  esac
  local ids=""
  if [ "$which" = "all" ]; then
    for d in "$MACHINES"/*/; do [ -f "$d/machine.json" ] && ids="$ids $(basename "$d")"; done
  else
    require_machine "$which"; ids="$which"
  fi

  local pass=0 fail=0
  for id in $ids; do
    local j; j="$(machine_dir "$id")/machine.json"
    local ex="$(machine_dir "$id")/solution/exploit.sh"
    local cat_ port target got expect
    cat_=$(pj_get "$j" category)
    if [ "$mode" = "lite" ]; then
      pj_has "$j" lite || { warn "$id : (lewati, tak ada mode lite)"; continue; }
      port=$(pj_get "$j" lite.port)
    else
      port=$(pj_get "$j" ports.0.host)
    fi
    [ -f "$ex" ] || { warn "$id : (lewati, tak ada solver exploit.sh)"; continue; }

    printf '%s[*]%s %-16s %s ... ' "$c_cyn" "$c_rst" "$id" "$mode"
    # start (subshell agar 'exit' di dalam tidak membunuh selftest)
    if [ "$mode" = "lite" ]; then ( cmd_lite up "$id" ) >/dev/null 2>&1
    else ( cmd_docker up "$id" ) >/dev/null 2>&1; fi

    if ! _sel_ready "$cat_" "$port" 60; then
      printf '%sSERVER TAK SIAP%s\n' "$c_red" "$c_rst"; fail=$((fail + 1))
      if [ "$mode" = "lite" ]; then ( cmd_lite down "$id" ) >/dev/null 2>&1; else ( cmd_docker down "$id" ) >/dev/null 2>&1; fi
      continue
    fi

    if [ "$cat_" = "pwn" ]; then target="$BIND $port"; else target="http://$BIND:$port"; fi
    got=$(TARGET="$target" sh "$ex" 2>/dev/null | grep -oE 'FLAG\{[^}]*\}' | head -n1)
    expect=$(flag_value "$id" user)

    if [ -n "$got" ] && [ "$got" = "$expect" ]; then
      printf '%sPASS%s  %s\n' "$c_grn" "$c_rst" "$got"; pass=$((pass + 1))
    else
      printf '%sFAIL%s  (dapat: %s)\n' "$c_red" "$c_rst" "${got:-<kosong>}"; fail=$((fail + 1))
    fi
    if [ "$mode" = "lite" ]; then ( cmd_lite down "$id" ) >/dev/null 2>&1; else ( cmd_docker down "$id" ) >/dev/null 2>&1; fi
  done

  printf '\n'
  if [ "$fail" -eq 0 ]; then ok "Selftest $mode: $pass PASS, 0 FAIL."
  else err "Selftest $mode: $pass PASS, $fail FAIL."; return 1; fi
}

# ---- docker mode -----------------------------------------------------------

docker_ok(){
  command -v docker >/dev/null 2>&1 || { err "docker tidak ada di host ini. Pakai mode 'lite', atau jalankan di PC."; exit 1; }
  docker info >/dev/null 2>&1 || { err "docker daemon tidak jalan / tidak ada izin."; exit 1; }
}

cmd_docker(){
  docker_ok; load_flags
  local action="${1:-}"; local id="${2:-}"
  [ -n "$id" ] || { err "sebutkan id mesin, mis: ./labctl docker up 01-pingboard"; exit 1; }
  require_machine "$id"
  local j; j="$(machine_dir "$id")/machine.json"
  local img="ctflab/$id"
  local cport hport
  cport=$(pj_get "$j" ports.0.container)
  hport=$(pj_get "$j" ports.0.host)

  case "$action" in
    build)
      info "build image $img ..."
      docker build -t "$img" "$(machine_dir "$id")"
      ok "image $img siap." ;;
    up)
      docker image inspect "$img" >/dev/null 2>&1 || docker build -t "$img" "$(machine_dir "$id")"
      local -a envs=()
      for slot in $(pj_arr "$j" flags); do
        envs+=( -e "FLAG_$(echo "$slot"|tr a-z A-Z)=$(flag_value "$id" "$slot")" )
      done
      docker rm -f "ctflab-$id" >/dev/null 2>&1 || true
      docker run -d --name "ctflab-$id" -p "${BIND}:${hport}:${cport}" "${envs[@]}" "$img" >/dev/null
      ok "jalan: http://${BIND}:${hport}  (container ctflab-$id)" ;;
    down)
      docker rm -f "ctflab-$id" >/dev/null 2>&1 && ok "dihentikan: $id" || warn "tidak jalan: $id" ;;
    status)
      docker ps --filter "name=ctflab-$id" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' ;;
    *)
      err "aksi docker tidak dikenal: '$action' (build|up|down|status)"; exit 1 ;;
  esac
}

# ---- lite mode (tanpa Docker) ---------------------------------------------

# Siapkan instance lite: cek port, salin app, tulis flag, bangun perintah.
# Hasil perintah diisi ke array global PREP_CMD[].
PREP_CMD=()
lite_prepare(){
  local j="$1" inst="$2" port="$3" id="$4" mdir="$5"
  if (exec 3<>"/dev/tcp/$BIND/$port") 2>/dev/null; then
    exec 3>&- 3<&-
    err "port $port sudah dipakai. Hentikan dulu: ./labctl lite down $id  (atau proses lain di port itu)"
    exit 1
  fi
  rm -rf "$inst"; mkdir -p "$inst"
  local src dst
  src=$(pj_keys "$j" lite.copy | head -1)
  dst=$(pj_get "$j" "lite.copy.$src")
  cp -r "$mdir/$src" "$inst/$dst"
  local uf; uf=$(pj_get "$j" lite.flag_files.user)
  [ -n "$uf" ] && flag_value "$id" user > "$inst/$uf"
  PREP_CMD=()
  local part
  while IFS= read -r part; do
    part="${part//\{bind\}/$BIND}"; part="${part//\{port\}/$port}"
    PREP_CMD+=("$part")
  done < <(pj_arr "$j" lite.cmd)
}

cmd_lite(){
  load_flags
  local action="${1:-}"; local id="${2:-}"
  [ -n "$id" ] || { err "sebutkan id mesin, mis: ./labctl lite up 01-pingboard"; exit 1; }
  require_machine "$id"
  local j mdir; j="$(machine_dir "$id")/machine.json"; mdir="$(machine_dir "$id")"
  pj_has "$j" lite || { err "mesin '$id' tidak punya mode lite."; exit 1; }

  local inst="$RUNDIR/$id"
  local pidf="$inst/.pid"
  local port; port=$(pj_get "$j" lite.port)

  case "$action" in
    up)
      if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
        warn "$id sudah jalan (pid $(cat "$pidf"))"; return 0
      fi
      lite_prepare "$j" "$inst" "$port" "$id" "$mdir"   # mengisi PREP_CMD[]
      # Background subshell yang langsung `exec` jadi server, supaya $! = PID server
      # yang tersimpan benar-benar proses itu (bukan subshell perantara).
      ( cd "$inst" && exec nohup "${PREP_CMD[@]}" >"$inst/.log" 2>&1 ) &
      echo $! > "$pidf"
      sleep 0.5
      if kill -0 "$(cat "$pidf")" 2>/dev/null; then
        local cat_; cat_=$(pj_get "$j" category)
        if [ "$cat_" = "pwn" ]; then
          ok "jalan: nc ${BIND} ${port}  (pid $(cat "$pidf"))"
        else
          ok "jalan: http://${BIND}:${port}  (pid $(cat "$pidf"))"
        fi
        local note; note=$(pj_get "$j" lite.note); [ -n "$note" ] && printf '    %s\n' "$note"
      else
        rm -f "$pidf"; err "gagal start. Log:"; cat "$inst/.log"; exit 1
      fi ;;
    run)
      # Foreground: server menggantikan proses ini (tanpa nohup), jadi ia MATI
      # otomatis saat terminal/panel tmux ditutup. Dipakai oleh ctf-tmux.
      lite_prepare "$j" "$inst" "$port" "$id" "$mdir"
      echo $$ > "$pidf"             # $$ tetap jadi PID server setelah exec
      local cat_; cat_=$(pj_get "$j" category)
      if [ "$cat_" = "pwn" ]; then info "SecureBox siap: nc ${BIND} ${port}"
      else info "siap: http://${BIND}:${port}"; fi
      cd "$inst" && exec "${PREP_CMD[@]}" ;;
    down)
      if [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null; then
        ok "dihentikan: $id"; rm -f "$pidf"
      else
        warn "tidak jalan: $id"
      fi ;;
    status)
      if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
        ok "$id : UP  http://${BIND}:${port}  (pid $(cat "$pidf"))"
      else
        info "$id : down"
      fi ;;
    *)
      err "aksi lite tidak dikenal: '$action' (up|down|status)"; exit 1 ;;
  esac
}

# ---- main ------------------------------------------------------------------

usage(){ sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  list)     cmd_list ;;
  flags)    cmd_flags ;;
  check)    shift; cmd_check "$@" ;;
  selftest) shift; cmd_selftest "$@" ;;
  docker)  shift; cmd_docker "$@" ;;
  lite)    shift; cmd_lite "$@" ;;
  ""|-h|--help|help) usage ;;
  *) err "perintah tidak dikenal: '$1'"; usage; exit 1 ;;
esac
