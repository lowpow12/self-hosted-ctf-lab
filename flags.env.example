# Copy to flags.env and change the values. flags.env is gitignored.
# Format: FLAG_<MACHINEID>_<SLOT>=FLAG{...}
FLAG_01_PINGBOARD_USER=FLAG{change_me_user}
FLAG_01_PINGBOARD_ROOT=FLAG{change_me_root}
FLAG_02_VAULTDOCS_USER=FLAG{change_me_vaultdocs_user}
FLAG_03_SNAPGALLERY_USER=FLAG{change_me_snap_user}
FLAG_03_SNAPGALLERY_ROOT=FLAG{change_me_snap_root}
FLAG_04_COOKIEJAR_USER=FLAG{change_me_cookiejar}
FLAG_05_RENDERBOX_USER=FLAG{change_me_renderbox}
FLAG_06_SAVESLOT_USER=FLAG{change_me_saveslot}
